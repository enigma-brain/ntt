# Local Claude Code state is ignored, except skills we deliberately track.
# Each level needs its own negation: git cannot re-include a path whose parent
# is excluded. Add one `!` line per skill you want tracked.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/ntt-eval-battery/
logs/
mlruns/
.worktrees/
results/

scripts/mlflow_eval_helpers/__pycache__/

# Data dir is tracked (via .gitkeep) but contents are not
data/*
!data/.gitkeep

# Artifacts dir is tracked (via .gitkeep) but contents are not
artifacts/*
!artifacts/.gitkeep

agent_assets/

# Top-level eval output dumps from local runs — never track
eval_outputs/
