# MLFLOW credentials
MLFLOW_TRACKING_URI=http://your-mlflow-server:port/
MLFLOW_TRACKING_USERNAME=your-mlflow-tracking-username
MLFLOW_TRACKING_PASSWORD=your-mlflow-tracking-password
# Personal tokens
GITHUB_TOKEN=your-github-token
HUGGINGFACE_TOKEN=your-huggingface-token
# Verbose hydra errors
HYDRA_FULL_ERROR=1 # enable more comprehensive error logging from hydra
# Container user (required) — run the following to add these to your .env:
#   echo -e "USER_ID=$(id -u)\nGROUP_ID=$(id -g)\nUSERNAME=$(whoami)" >> .env
USER_ID=1000
GROUP_ID=1000
USERNAME=youruser
